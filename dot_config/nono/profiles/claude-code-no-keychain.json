{
  "extends": "default",
  "meta": {
    "name": "claude-code-no-keychain",
    "version": "1.1.0",
    "description": "Claude Code base profile without Keychain access (forked from always-further/claude)"
  },
  "groups": {
    "include": [
      "claude_code_linux",
      "user_caches_macos",
      "claude_cache_linux",
      "node_runtime",
      "rust_runtime",
      "python_runtime",
      "vscode_macos",
      "vscode_linux",
      "linux_sysfs_read",
      "nix_runtime",
      "git_config",
      "unlink_protection"
    ]
  },
  "security": {
    "signal_mode": "isolated",
    "capability_elevation": false
  },
  "filesystem": {
    "allow": [
      "$HOME/.claude",
      "$HOME/.cc-writes",
      "$HOME/.cache/claude",
      "$HOME/.config/nono/profiles",
      "/tmp/claude-$UID"
    ],
    "read": [
      "$HOME/.config/nono/packages",
      "$HOME/.local/share/claude",
      "$HOME/Applications/Claude Code URL Handler.app"
    ],
    "allow_file": [
      "$HOME/.claude.json",
      "$HOME/.claude.json.lock",
      "$HOME/.claude.lock"
    ]
  },
  "network": { "block": false },
  "workdir": { "access": "readwrite" },
  "open_urls": {
    "allow_origins": ["https://claude.ai"],
    "allow_localhost": true
  },
  "allow_launch_services": true,
  "undo": {
    "exclude_patterns": ["node_modules", ".next", "__pycache__", "target"],
    "exclude_globs": ["*.tmp.[0-9]*.[0-9]*"]
  },
  "interactive": true
}
