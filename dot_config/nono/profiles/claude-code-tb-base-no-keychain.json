{
  "$schema": "./nono-profile.schema.json",
  "extends": "tb-base-no-keychain",
  "meta": {
    "name": "claude-code-tb-base-no-keychain",
    "version": "1.2.0",
    "description": "Claude Code on top of tb-base-no-keychain (forked from always-further/claude). Uses the Linux groups on purpose: the macOS group grants Keychain access."
  },
  "groups": {
    "include": [
      "claude_code_linux",
      "claude_cache_linux"
    ]
  },
  "filesystem": {
    "allow": [
      "$HOME/.claude",
      "$HOME/.cc-writes",
      "$HOME/.cache/claude",
      "$HOME/.local/state/claude/locks",
      "/tmp/claude-$UID"
    ],
    "allow_file": [
      "$HOME/.claude.json",
      "$HOME/.claude.json.lock",
      "$HOME/.claude.lock"
    ],
    "read": [
      "$HOME/.local/share/claude",
      "$HOME/Applications/Claude Code URL Handler.app"
    ]
  }
}
