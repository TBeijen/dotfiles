{
  "$schema": "./nono-profile.schema.json",
  "extends": "opencode-tb",
  "meta": {
    "name": "opencode-tb-sso",
    "version": "0.1.0",
    "description": "EXPERIMENTAL: opencode-tb plus OpenAI OAuth capture, so the sandbox only sees phantom tokens. Endpoints adapted from nono's Codex device-auth example; unverified for opencode."
  },
  "network": {
    "open_port": [
      // Loopback callback for browser-based OpenAI login (Codex uses 1455). Unverified for opencode.
      1455
    ],
    "tls_intercept": {
      "ca_validity": "30d"
    }
  },
  "credential_providers": {
    "openai_oauth": {
      "type": "oauth_capture",
      "token_endpoints": [
        {
          // Device / headless login (as in the Codex example)
          "host": "https://auth.openai.com",
          "path": "/api/accounts/deviceauth/token",
          "response_fields": [
            { "path": "access_token", "kind": "opaque" },
            { "path": "refresh_token", "kind": "opaque" },
            { "path": "id_token", "kind": "jwt" }
          ],
          "request_body": "form",
          "request_nonce_fields": ["refresh_token"]
        },
        {
          // Browser login code exchange and refresh
          "host": "https://auth.openai.com",
          "path": "/oauth/token",
          "response_fields": [
            { "path": "access_token", "kind": "opaque" },
            { "path": "refresh_token", "kind": "opaque" },
            { "path": "id_token", "kind": "jwt" }
          ],
          "request_body": "auto",
          "request_nonce_fields": ["refresh_token"]
        }
      ],
      "api_hosts": [
        "https://api.openai.com",
        "https://auth.openai.com",
        "https://chatgpt.com"
      ]
    }
  },
  "credential_routes": [
    {
      "name": "openai_oauth",
      "provider": "openai_oauth"
    }
  ]
}
