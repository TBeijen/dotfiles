{
  "$schema": "./nono-profile.schema.json",
  "extends": "opencode-tb",
  "meta": {
    "name": "opencode-tb-device-code",
    "version": "0.2.0",
    "description": "opencode-tb plus OpenAI OAuth capture, so the sandbox only sees phantom tokens. Only works with opencode's 'Codex device code (legacy)' login: the browser token-sharing login verifies the ID token signature, which a phantom cannot pass. Needs device code authorization enabled in OpenAI security settings."
  },
  "network": {
    "tls_intercept": {
      "ca_validity": "30d"
    }
  },
  "credential_providers": {
    "openai_oauth": {
      "type": "oauth_capture",
      "token_endpoints": [
        {
          // Device / headless login (as in the Codex example)
          "host": "https://auth.openai.com",
          "path": "/api/accounts/deviceauth/token",
          "response_fields": [
            { "path": "access_token", "kind": "opaque" },
            { "path": "refresh_token", "kind": "opaque" },
            { "path": "id_token", "kind": "jwt" }
          ],
          "request_body": "form",
          "request_nonce_fields": ["refresh_token"]
        },
        {
          // Browser login code exchange (path seen in the nono log)
          "host": "https://auth.openai.com",
          "path": "/api/accounts/oauth/token",
          "response_fields": [
            { "path": "access_token", "kind": "opaque" },
            { "path": "refresh_token", "kind": "opaque" },
            { "path": "id_token", "kind": "jwt" }
          ],
          "request_body": "auto",
          "request_nonce_fields": ["refresh_token"]
        },
        {
          // Possible refresh path (as in the Codex example)
          "host": "https://auth.openai.com",
          "path": "/oauth/token",
          "response_fields": [
            { "path": "access_token", "kind": "opaque" },
            { "path": "refresh_token", "kind": "opaque" },
            { "path": "id_token", "kind": "jwt" }
          ],
          "request_body": "auto",
          "request_nonce_fields": ["refresh_token"]
        }
      ],
      "api_hosts": [
        "https://api.openai.com",
        "https://auth.openai.com",
        "https://chatgpt.com"
      ]
    }
  },
  "credential_routes": [
    {
      "name": "openai_oauth",
      "provider": "openai_oauth"
    }
  ]
}
